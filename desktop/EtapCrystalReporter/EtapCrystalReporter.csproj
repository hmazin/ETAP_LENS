<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <ProjectGuid>{C0F8847F-FF54-4B38-88A1-A04E08D2ED94}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EtapCrystalReporter</RootNamespace>
    <AssemblyName>EtapCrystalReporter</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <LangVersion>5</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationConfig>App.config</ApplicationConfig>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Data" /><Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Xml" />
    <Reference Include="System.Web.Extensions" /><Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.SQLite">
      <HintPath>..\.packages\system.data.sqlite.2.0.4\lib\net471\System.Data.SQLite.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="Program.cs" /><Compile Include="Models\*.cs" />
    <Compile Include="Services\*.cs" /><Compile Include="Utilities\*.cs" /><Compile Include="UI\*.cs" />
    <None Include="App.config" />
    <Content Include="Templates\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\.packages\sourcegear.sqlite3.3.53.4\runtimes\win-$(Platform)\native\e_sqlite3.dll">
      <Link>e_sqlite3.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CheckDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\.packages\system.data.sqlite.2.0.4\lib\net471\System.Data.SQLite.dll')"
           Text="Run powershell -File ..\build.ps1 -RestoreOnly first." />
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'x86'" Text="Choose x64 or x86 to match the installed Crystal runtime." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
