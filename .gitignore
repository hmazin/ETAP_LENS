__pycache__/
*.pyc
.venv/
venv/

# Loaded project/study data - never commit real ETAP data
cache/
*.sqlite
*.db

# Local editor/OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# Windows Crystal Reports companion (client data and vendor binaries stay local)
.tools/
/output/
desktop/**/bin/
desktop/**/obj/
desktop/.packages/
desktop/**/Logs/
desktop/**/Templates/**/*.rpt
# .rpt.json sidecars ARE tracked: they hold no proprietary content, only
# generic schema-compatibility fixes (FieldMappings/OptionalFields) for the
# licensed .rpt templates above, worth keeping across clones.
*.SA1S
*.SA2S
*.sa1s
*.sa2s
