{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": { "age": 1, "matchesPrefix": ["uploads/"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 7, "matchesPrefix": ["caches/", "reports/sources/", "reports/pdfs/"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 8, "matchesPrefix": ["reports/state/"] }
      }
    ]
  }
}
